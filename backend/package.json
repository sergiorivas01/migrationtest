{
  "name": "imageproject-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API en Node.js/Express con PostgreSQL",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --inspect=9229 --project tsconfig.json --respawn --transpile-only server.ts",
    "build": "tsc -p .",
    "migrate:up": "ts-node scripts/migrateHelper.ts up",
    "migrate:down": "ts-node scripts/migrateHelper.ts down",
    "migrate:create": "ts-node scripts/createMigration.ts",
    "db:init": "ts-node scripts/initDatabase.ts"
  },
  "engines": {
    "node": "^20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/node": "^24.9.2",
    "node-pg-migrate": "^8.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}


